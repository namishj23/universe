# Copy to apps/api/.env.test and fill in. Never commit .env.
NODE_ENV=test
PORT=4000
DATABASE_URL=postgresql://universe:CHANGE_ME@localhost:5432/universe_test
# Comma-separated origins allowed for CORS and for unsafe requests that send an Origin header.
WEB_ORIGINS=http://localhost:5173,http://localhost:4000,http://127.0.0.1:4000
# true when served over HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
TRUST_PROXY=false
LOG_LEVEL=silent
# At least 32 random bytes, base64. Generate with: openssl rand -base64 32
CSRF_SECRET=CHANGE_ME
# Used only by `npm run db:seed` for every demo account. At least 12 characters.
SEED_DEMO_PASSWORD=CHANGE_ME
# At least 32 random bytes, base64 (openssl rand -base64 32). Keys the email HMAC in
# login_throttle and in failed-login audit entries. Use a different value from CSRF_SECRET.
EMAIL_HMAC_SECRET=CHANGE_ME
# STORAGE_DIR is set by vitest.config.ts to a fresh temporary folder for every run.
