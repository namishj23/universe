{
  "name": "@universe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@universe/source --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/modules', 'dist/modules', { recursive: true, filter: (f) => !f.endsWith('.ts') })\"",
    "start": "NODE_ENV=${NODE_ENV:-production} node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:docs": "tsx --conditions=@universe/source --env-file-if-exists=.env scripts/write-openapi.ts",
    "docs:roles": "tsx --conditions=@universe/source --env-file-if-exists=.env scripts/write-roles.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@universe/contracts": "0.1.0",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/busboy": "^1.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@universe/wellbeing-core": "0.1.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
